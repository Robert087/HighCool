{
  "Database": {
    "Provider": "Sqlite",
    "SqliteFileName": "highcool.db"
  },
  "LocalStorage": {
    "DataDirectory": "",
    "BackupDirectory": "",
    "PendingBackupDirectory": "",
    "LogDirectory": ""
  },
  "LocalDatabase": {
    "AllowDevelopmentReset": false
  },
  "Desktop": {
    "StartupToken": ""
  },
  "BackupRetention": {
    "Enabled": true,
    "ManualCount": 10,
    "ScheduledCount": 24,
    "BeforeMigrationCount": 10,
    "BeforeRestoreCount": 10,
    "BeforeApplicationUpdateCount": 10,
    "MinimumAgeHoursBeforeDeletion": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
